# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
ENV/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
!.env.example

# Local user data that should not be published by accident
# Keep directory placeholders (.gitkeep) tracked.
data/generated/*
!data/generated/.gitkeep

# Python type checker / packaging
.python-version
uv.lock
